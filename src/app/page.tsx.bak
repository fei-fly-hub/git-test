'use client';

import { useChat } from '@ai-sdk/react';
import { useEffect, useRef, useState } from 'react'; // ✅ 引入 useState
import ReactMarkdown from 'react-markdown';

export default function Home() {
  // 1. 使用 useState 自己管理输入框状态
  const [input, setInput] = useState('');

  // 2. 新版 useChat 只返回 messages, sendMessage, status, error 等
  const { messages, sendMessage, status, error } = useChat();

  const messagesEndRef = useRef<HTMLDivElement>(null);

  // 每次消息更新时，自动滚动到最底部
  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages]);

  // 判断是否正在加载 (streaming 或 submitted 状态)
  const isStreaming = status === 'streaming' || status === 'submitted';

  return (
    <main className="flex flex-col h-screen bg-gray-50 max-w-3xl mx-auto p-4 shadow-lg">
      {/* 顶部标题 */}
      <header className="border-b pb-4 mb-4">
        <h1 className="text-2xl font-bold text-gray-800">🤖 Unitree AI 助手 (RAG)</h1>
        <p className="text-sm text-gray-500">基于本地文档知识库的智能问答</p>
      </header>

      {/* 消息列表区域 */}
      <div className="flex-1 overflow-y-auto space-y-4 pr-2">
        {messages.length === 0 && (
          <div className="text-center text-gray-400 mt-10">
            <p> 你好！请问有什么我可以帮你的？</p>
            <p className="text-sm mt-2">试试问："README.md 里说了什么？"</p>
          </div>
        )}

        {messages.map((m) => (
          <div
            key={m.id}
            className={`flex ${m.role === 'user' ? 'justify-end' : 'justify-start'}`}
          >
            <div
              className={`max-w-[85%] p-4 rounded-2xl shadow-sm ${m.role === 'user'
                ? 'bg-blue-600 text-white rounded-br-none'
                : 'bg-white text-gray-800 border border-gray-200 rounded-bl-none'
                }`}
            >
              {/* 3. 新版消息结构是 parts 数组，需要遍历渲染 */}
              {m.role === 'assistant' ? (
                <div className="prose prose-sm max-w-none">
                  {m.parts.map((part, i) => {
                    if (part.type === 'text') {
                      return (
                        <ReactMarkdown key={i}>{part.text}</ReactMarkdown>
                      );
                    }
                    return null;
                  })}
                </div>
              ) : (
                // 用户消息也遍历 parts
                <p className="whitespace-pre-wrap">
                  {m.parts
                    .filter(p => p.type === 'text')
                    .map(p => p.text)
                    .join('')}
                </p>
              )}
            </div>
          </div>
        ))}

        {/* 4. 加载中状态 (使用 status 判断) */}
        {isStreaming && (
          <div className="flex justify-start">
            <div className="bg-white p-4 rounded-2xl rounded-bl-none border border-gray-200 text-gray-500 text-sm">
              🧠 AI 正在思考并检索文档...
            </div>
          </div>
        )}

        {/* 错误提示 */}
        {error && (
          <div className="text-center text-red-500 text-sm">
            出错了: {error.message}
          </div>
        )}

        {/* 用于自动滚动的锚点 */}
        <div ref={messagesEndRef} />
      </div>

      {/* 5. 底部输入框 (手动处理提交) */}
      <form
        onSubmit={(e) => {
          e.preventDefault();
          if (input.trim()) {
            sendMessage({ text: input }); // ✅ 使用 sendMessage 发送
            setInput(''); // ✅ 手动清空输入框
          }
        }}
        className="mt-4 flex gap-2"
      >
        <input
          className="flex-1 p-3 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
          value={input}
          placeholder="输入你的问题..."
          onChange={(e) => setInput(e.currentTarget.value)} // ✅ 手动更新 input
          disabled={isStreaming}
        />
        <button
          type="submit"
          disabled={isStreaming || !input.trim()}
          className="px-6 py-3 bg-blue-600 text-white font-medium rounded-xl hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed transition shadow-md"
        >
          发送
        </button>
      </form>
    </main>
  );
}